# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Full SRV connection string from Azure Portal -> mskr-documentdb -> Connection strings
# Example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
# NOTE: wrap the URI in single quotes — it contains `&` characters that would
#       otherwise be interpreted by your shell when sourced.
MONGODB_URI='mongodb+srv://USER:PASSWORD@CLUSTER.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000'

# Database and collection that the test page operates against.
MONGODB_DB=jsonvalidator
MONGODB_COLLECTION=requests

# Flask
FLASK_SECRET=change-me
PORT=8000
